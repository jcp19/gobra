// ##(--hyperMode extended --experimentalHyperfuncs)
package extended01

// Hyperfuncs in the extended encoding, which supports branches on secrets.

decreases
hyperfunc NonInterf(input, output any) bool {
	return low(input) ==> low(output)
}

// a secret branch: rejected by the low-guard encoding, verified in the extended encoding
ensures NonInterf(x, res)
func Abs(x int) (res int) {
	res = x
	if x < 0 {
		res = -x
	}
	return res
}

// branches on a secret and leaks it
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures NonInterf(pub, res)
func Leak(pub, sec int) (res int) {
	res = 0
	if sec > 0 {
		res = 1
	}
	return res
}

decreases
hyperfunc Dist(x int) int {
	return rel(x, 0) >= rel(x, 1) ? rel(x, 0) - rel(x, 1) : rel(x, 1) - rel(x, 0)
}

// counting query with a secret branch (theory notes, Listing 2), for two inputs that differ by at most one
requires Dist(a) <= 1 && 0 <= a && a <= 1
ensures  Dist(r) <= 1
func CountOne(a int) (r int) {
	r = 0
	if a > 0 {
		r = r + 1
	}
	return r
}

// execution parameters
decreases
hyperfunc Agree(x any, i, j exec) bool {
	return rel(x, i) === rel(x, j)
}

requires Agree(x, 0, 1)
ensures  Agree(res, 0, 1)
func Inc(x int) (res int) {
	return x + 1
}

// recursive, heap-independent, with a rigid parameter
requires low(n) && 0 <= n && n <= len(s)
decreases n
hyperfunc Hamming(s seq[int], n int) int {
	return n == 0 ? 0 : Hamming(s, n - 1) + (rel(s[n - 1], 0) == rel(s[n - 1], 1) ? 0 : 1)
}

decreases
hyperfunc Differs(x int) int {
	return rel(x, 0) == rel(x, 1) ? 0 : 1
}

ghost
requires low(len(s)) && len(s) == 2 && Hamming(s, 2) == 0
ensures  low(s[0]) && low(s[1])
decreases
func Unfold(s seq[int]) {
	assert Hamming(s, 2) == Hamming(s, 1) + Differs(s[1])
	assert Hamming(s, 1) == Hamming(s, 0) + Differs(s[0])
}

// heap-dependent: inlined
requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], _)
decreases
hyperfunc LowSlice(s []int) bool {
	return low(len(s)) && forall i int :: { &s[i] } 0 <= i && i < len(s) ==> low(s[i])
}

requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
requires LowSlice(s) && len(s) > 0
ensures  forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
ensures  low(r)
func First(s []int) (r int) {
	r = s[0]
	if s[0] > 10 {
		r = s[0] - 10
	}
	return r
}

// abstract hyperfunc
decreases
hyperfunc R(x int) bool

requires R(x)
ensures  R(res)
func Id(x int) (res int) {
	return x
}

requires R(x)
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures  R(res)
func NotId(x int) (res int) {
	return x + 1
}

// Soundness: a relational postcondition of a call is assumed only if both executions make the call.
ensures NonInterf(0, r)
func MkLow() (r int)

//:: ExpectedOutput(postcondition_error:assertion_error)
ensures NonInterf(0, res)
func CallInSecretBranch(sec int) (res int) {
	res = 0
	if sec > 0 {
		res = MkLow()
	}
	return res
}

requires low(pub)
ensures  NonInterf(0, res)
func CallInPublicBranch(pub int) (res int) {
	res = 0
	if pub > 0 {
		res = MkLow()
	}
	return res
}

// sensitivity is not preserved by an unbounded secret-dependent update
requires Dist(a) <= 1
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures  Dist(r) <= 1
func Scale(a int) (r int) {
	r = 0
	if a > 0 {
		r = 2 * a
	}
	return r
}

// without the lowness of the contents, the first element is not low
requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
requires low(len(s)) && len(s) > 0
ensures  forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures  LowSlice(s)
func NotLowSlice(s []int) {}

// Inlined bodies: an unfolding needs only some permission, and bound variables do not clash with the caller's.
type Record struct {
	payload int
	public bool
}

pred (r *Record) Mem() { acc(&r.payload) && acc(&r.public) }

requires acc(r.Mem(), _)
decreases
hyperfunc (r *Record) Classified() bool {
	return unfolding r.Mem() in low(r.public) && (r.public ==> low(r.payload))
}

requires acc(r.Mem(), 1/2) && r.Classified()
ensures  acc(r.Mem(), 1/2) && low(res)
func (r *Record) Publish() (res int) {
	unfold acc(r.Mem(), 1/2)
	res = 0
	if r.public {
		res = r.payload
	}
	fold acc(r.Mem(), 1/2)
	return res
}

requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], _)
decreases
hyperfunc NeighboursAt(s []int, j int) bool {
	return low(len(s)) && low(j) && forall i int :: { &s[i] } 0 <= i && i < len(s) && i != j ==> low(s[i])
}

requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2) && 0 <= s[i] && s[i] <= 1
requires NeighboursAt(s, j)
ensures  forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
ensures  Dist(count) <= 1
func Count(s []int, ghost j int) (count int) {
	invariant 0 <= i && i <= len(s) && low(i)
	invariant forall k int :: { &s[k] } 0 <= k && k < len(s) ==> acc(&s[k], 1/2) && 0 <= s[k] && s[k] <= 1
	invariant NeighboursAt(s, j)
	invariant Dist(count) <= (rel(j, 0) < i ? 1 : 0)
	for i := 0; i < len(s); i++ {
		count += s[i]
	}
	return count
}
